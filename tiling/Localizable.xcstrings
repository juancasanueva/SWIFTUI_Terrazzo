    "macOS couldn't set up Tiling's keyboard shortcuts. Quit and reopen Tiling.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo configurar los atajos de Tiling. Sal y vuelve a abrir Tiling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は Tiling のショートカットを設定できませんでした。Tiling を終了して開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 Tiling의 단축키를 설정할 수 없습니다. Tiling을 종료한 후 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 无法设置 Tiling 的键盘快捷键。请退出并重新打开 Tiling。"
          }
        }
      }
    },
