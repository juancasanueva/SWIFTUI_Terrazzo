    "This screen is full, so the window joined this tile's stack.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla está llena, así que la ventana se unió a la pila de este mosaico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が満杯のため、ウインドウはこのタイルのスタックに入りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
