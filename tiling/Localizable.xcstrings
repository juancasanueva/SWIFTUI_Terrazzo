{
  "sourceLanguage": "en",
  "strings": {
    "%@ has an error. Fix it to save this change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene un error. Corrígelo para guardar este cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にエラーがあります。この変更を保存するには修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 오류가 있습니다. 이 변경 사항을 저장하려면 수정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有错误。请修复后再保存此更改。"
          }
        }
      }
    },
    "%@ has an error. Keeping the last good values.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene un error. Se mantienen los últimos valores válidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にエラーがあります。最後に有効だった値を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 오류가 있습니다. 마지막으로 유효했던 값을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有错误。继续使用上次的有效值。"
          }
        }
      }
    },
    "%@ is already in use:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en uso:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすでに使用されています:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 사용 중입니다:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被占用:"
          }
        }
      }
    },
