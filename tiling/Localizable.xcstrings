    "Another app turned on Secure Input. Shortcuts are paused until it ends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app activó la entrada segura. Los atajos están en pausa hasta que termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリが安全な入力をオンにしました。終了するまでショートカットは一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 보안 입력을 켰습니다. 끝날 때까지 단축키가 일시 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一应用开启了安全输入。在其结束前快捷键已暂停。"
          }
        }
      }
    },
